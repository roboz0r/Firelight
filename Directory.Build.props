<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Robert Lenders</Authors>
    <Copyright>Copyright (c) Robert Lenders 2025</Copyright>
    <PackageVersion>0.2.0</PackageVersion>
    <RepositoryUrl>https://github.com/roboz0r/Firelight</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/roboz0r/Firelight</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-128.png</PackageIcon>
  </PropertyGroup>
  <PropertyGroup Label="F# Specific Options" Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <DisableImplicitSystemValueTupleReference>true</DisableImplicitSystemValueTupleReference>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <!-- Use lock files -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(RepoRoot)images/icon-128.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    README.md opens with the logo as an HTML <img>, for GitHub. nuget.org doesn't render HTML in a
    readme (it would show the tag as text) or images with relative paths, and the package has its
    icon anyway, so packages get a copy of README.md without that first line.
  -->
  <Target Name="PackReadmeWithoutLogo" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_PackedReadme>$(IntermediateOutputPath)README.md</_PackedReadme>
      <_ReadmeText>$([System.IO.File]::ReadAllText('$(RepoRoot)README.md'))</_ReadmeText>
      <_ReadmeText>$([System.Text.RegularExpressions.Regex]::Replace('$(_ReadmeText)', '^&lt;p align=&quot;center&quot;&gt;&lt;img [^\n]*\n\s*', ''))</_ReadmeText>
    </PropertyGroup>
    <Error Condition="$(_ReadmeText.StartsWith('&lt;'))" Text="README.md still starts with HTML after removing the logo line; nuget.org would show it as text." />
    <WriteLinesToFile File="$(_PackedReadme)" Lines="$([MSBuild]::Escape('$(_ReadmeText)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_PackedReadme)" Pack="true" PackagePath="/" />
    </ItemGroup>
  </Target>
</Project>