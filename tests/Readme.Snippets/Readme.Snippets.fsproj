<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles every ```fsharp block in README.md as its own module, so README examples that stop
    compiling fail the build. Each block must be self-contained. Errors are reported against
    README.md line numbers.

      dotnet build tests/Readme.Snippets
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ReadmePath>$(RepoRoot)README.md</ReadmePath>
    <SnippetDirectory>$(BaseIntermediateOutputPath)readme\</SnippetDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ReadmePath)" Link="README.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Firelight\Firelight.fsproj" />
    <ProjectReference Include="..\..\src\Firelight.Context\Firelight.Context.fsproj" />
    <ProjectReference Include="..\..\src\Firelight.Elmish\Firelight.Elmish.fsproj" />
    <ProjectReference Include="..\..\src\Firelight.Motion\Firelight.Motion.fsproj" />
    <ProjectReference Include="..\..\src\Firelight.Router\Firelight.Router.fsproj" />
    <ProjectReference Include="..\..\src\Firelight.Signals\Firelight.Signals.fsproj" />
    <ProjectReference Include="..\..\src\Firelight.Task\Firelight.Task.fsproj" />
  </ItemGroup>

  <UsingTask TaskName="ExtractFSharpBlocks" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Markdown ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = File.ReadAllText(Markdown).Replace("\r\n", "\n");
        Directory.CreateDirectory(OutputDirectory);
        foreach (var old in Directory.GetFiles(OutputDirectory, "*.fs")) File.Delete(old);

        var blocks = Regex.Matches(text, "^```fsharp\n(.*?)^```", RegexOptions.Multiline | RegexOptions.Singleline);
        var files = new List<ITaskItem>();
        for (var i = 0; i < blocks.Count; i++)
        {
            var code = blocks[i].Groups[1];
            var line = text.Take(code.Index).Count(c => c == '\n') + 1;
            var name = "Snippet" + (i + 1).ToString("00");
            var path = Path.Combine(OutputDirectory, name + ".fs");
            // The line directive makes compiler errors point at the block in the README.
            File.WriteAllText(path, "module Readme." + name + "\n\n# " + line + " \"" + Markdown.Replace('\\', '/') + "\"\n" + code.Value);
            files.Add(new TaskItem(path));
        }
        Files = files.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="IncludeReadmeSnippets" BeforeTargets="BeforeBuild">
    <ExtractFSharpBlocks Markdown="$(ReadmePath)" OutputDirectory="$(SnippetDirectory)">
      <Output TaskParameter="Files" ItemName="Compile" />
    </ExtractFSharpBlocks>
  </Target>
</Project>
