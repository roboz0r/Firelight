<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="package.json" />
    <None Include="vite.config.js" />
    <None Include="build-demos.mjs" />
    <None Include="check-template.mjs" />
    <None Include="site.css" />
    <None Include="content/**/*.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- Each file registers its own custom element; the HTML pages load them as module scripts.
         Snippets are independent modules, so the glob's alphabetical order doesn't matter, and a
         new page's snippet needs no edit here. -->
    <Compile Include="Components/Search.fs" />
    <Compile Include="Snippets/**/*.fs" />
    <Compile Include="Routing/RouteExplorer.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Firelight\Firelight.fsproj" />
    <ProjectReference Include="..\src\Firelight.Context\Firelight.Context.fsproj" />
    <ProjectReference Include="..\src\Firelight.Elmish\Firelight.Elmish.fsproj" />
    <ProjectReference Include="..\src\Firelight.Motion\Firelight.Motion.fsproj" />
    <ProjectReference Include="..\src\Firelight.Observers\Firelight.Observers.fsproj" />
    <ProjectReference Include="..\src\Firelight.Router\Firelight.Router.fsproj" />
    <ProjectReference Include="..\src\Firelight.Signals\Firelight.Signals.fsproj" />
    <ProjectReference Include="..\src\Firelight.Task\Firelight.Task.fsproj" />
    <ProjectReference Include="..\src\Firelight.Virtualizer\Firelight.Virtualizer.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- For promise { } in the demos. Firelight.Task brings it in through Fable.Fetch. -->
    <PackageReference Include="Fable.Promise" />
  </ItemGroup>
</Project>
